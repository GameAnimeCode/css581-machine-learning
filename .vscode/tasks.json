{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: Python environment",
      "type": "shell",
      "command": "scripts/setup-python.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Create .venv and install requirements.txt"
    },
    {
      "label": "Assignment: New",
      "type": "shell",
      "command": "scripts/new-assignment.sh",
      "args": ["${input:newAssignmentName}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Create assignments/<name> from the templates and refresh the README index"
    },
    {
      "label": "Writeup: Build one",
      "type": "shell",
      "command": "scripts/build-writeup.sh",
      "args": ["${input:buildAssignmentName}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Render assignments/<name>/writeup.qmd to PDF"
    },
    {
      "label": "Writeup: Build all",
      "type": "shell",
      "command": "scripts/build-writeup.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Render every assignment writeup to PDF"
    }
  ],
  "inputs": [
    {
      "id": "newAssignmentName",
      "type": "promptString",
      "description": "New assignment folder name (for example a2-linear-regression)"
    },
    {
      "id": "buildAssignmentName",
      "type": "promptString",
      "description": "Assignment folder to build (for example a1-ml-foundations)"
    }
  ]
}
